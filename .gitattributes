# 统一行尾，避免 Windows / Linux 协作者互相污染 diff
* text=auto eol=lf

# 二进制文件不参与 diff 与行尾转换
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.docx binary
*.joblib binary

# 锁定 shell 脚本为 LF，否则在容器内执行会报 CRLF 错误
*.sh text eol=lf

# 生成的 / 第三方内容不参与语言统计
static/vendor/** linguist-vendored
cache/** linguist-generated
*.min.js linguist-generated
